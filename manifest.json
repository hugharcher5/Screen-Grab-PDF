{
  "manifest_version": 3,
  "name": "Screen Capture to Downloads",
  "version": "1.1.2",
  "description": "Save the active tab as a PDF and attach it to ChatGPT, Claude, or Gemini.",
  "permissions": ["activeTab", "scripting", "downloads", "debugger", "storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Screen Capture to Downloads"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "capture-pdf-to-downloads": {
      "suggested_key": {
        "default": "Ctrl+Shift+C",
        "mac": "Command+Shift+C"
      },
      "description": "Save active tab as PDF directly to Downloads"
    },
    "attach-pdf-to-chat": {
      "suggested_key": {
        "default": "Ctrl+Shift+V",
        "mac": "Command+Shift+V"
      },
      "description": "Attach latest captured PDF to active AI chat window"
    }
  }
}
